# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Next.js & Build Outputs
# ==========================================
.next/
out/
build/
dist/
.turbo/
.cache/

# ==========================================
# TypeScript & Type Checking
# ==========================================
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Ignore all environment variables except example templates
.env
.env.*
!.env.example
!.env*.example
*.pem

# ==========================================
# Supabase & Local Database Mock
# ==========================================
supabase/.local-db.json
*.local-db.json
.local-db/
supabase/.temp/
supabase/.branches/

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# Logs & Debugging
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ==========================================
# Vercel & Deployment
# ==========================================
.vercel/

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# IDE & Code Editors
# ==========================================
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/
